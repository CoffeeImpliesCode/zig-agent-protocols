export DIRENV_WARN_TIMEOUT=20s

# Scratch bootstrap. It runs before `devenv direnvrc` on purpose: that line
# writes .devenv/ and evaluates devenv.nix, which is where the same five
# variables are declared for the environment proper. Declaring them here too
# means nothing this shell does on the way there writes to /tmp or /var/tmp,
# and that a shell which already carries the environment does not depend on
# this file being re-sourced to find out where scratch is.
#
# The policy is one root, derived rather than configured, in the order
# README.md records: node-local physical mounts first, approved NFS scratch
# as a fallback. An inherited value is not trusted. One that names a
# removed or unapproved path is worse than an unset one, because it looks
# like an answer.
_zap_user=$(id -un)
_zap_min_free_gib=${ZIG_AGENT_PROTOCOLS_SCRATCH_MIN_FREE_GIB:-100}
case $_zap_min_free_gib in '' | *[!0-9]*) _zap_min_free_gib=100 ;; esac
_zap_min_free_kib=$((_zap_min_free_gib * 1024 * 1024))
_zap_root=

for _zap_mount in /home/tmp2 /home/tmp /vol/tmp2 /vol/tmp; do
    # Three facts rather than one. It has to be a mount in its own right (an
    # autofs stub is not somewhere to put anything), writable by this
    # account, and have room: capacity is checked before the directory is
    # created, so a volume that is nearly full is skipped rather than filled.
    mountpoint -q -- "$_zap_mount" || continue
    [ -w "$_zap_mount" ] || continue
    _zap_kib=$(df -Pk -- "$_zap_mount" | sed -n '2p' | awk '{print $4}')
    case $_zap_kib in '' | *[!0-9]*) continue ;; esac
    [ "$_zap_kib" -ge "$_zap_min_free_kib" ] || continue
    _zap_root="$_zap_mount/$_zap_user/zig-agent-protocols"
    break
done

if [ -z "$_zap_root" ]; then
    echo "envrc: no approved scratch mount with at least $_zap_min_free_gib GiB free." >&2
    echo "  /tmp and /var/tmp are not approved: they are small volumes every process on" >&2
    echo "  the node shares, and the interoperability peers refuse them by name." >&2
    return 1
fi

# The directories the environment writes through, checked before they are
# created and refused if one is a symlink or belongs to another account:
# writing through either is how a path that looks approved ends up somewhere
# else. 077, because these are per-account directories on a mount every
# account on the node can read.
for _zap_path in "$_zap_root" "$_zap_root/tmp" "$_zap_root/cache" \
    "$_zap_root/xdg-data" "$_zap_root/zig-cache" "$_zap_root/build-cache"; do
    if [ -e "$_zap_path" ] || [ -L "$_zap_path" ]; then
        if [ ! -d "$_zap_path" ] || [ -L "$_zap_path" ] || [ ! -O "$_zap_path" ]; then
            echo "envrc: refusing $_zap_path: not a directory this account owns." >&2
            return 1
        fi
    fi
done
(umask 077
mkdir -p -- "$_zap_root/tmp" "$_zap_root/cache" "$_zap_root/xdg-data" \
    "$_zap_root/zig-cache" "$_zap_root/build-cache") || return 1

export TMPDIR="$_zap_root/tmp" TMP="$_zap_root/tmp" TEMP="$_zap_root/tmp"
export XDG_CACHE_HOME="$_zap_root/cache"
export XDG_DATA_HOME="$_zap_root/xdg-data"
export ZIG_GLOBAL_CACHE_DIR="$_zap_root/zig-cache"
export ZIG_LOCAL_CACHE_DIR="$_zap_root/build-cache"
unset _zap_user _zap_min_free_gib _zap_min_free_kib _zap_mount _zap_kib \
    _zap_root _zap_path

eval "$(devenv direnvrc)"

# `use devenv` supports the same options as the `devenv shell` command.
#
# To silence the output, use `--quiet`.
#
# Example usage: use devenv --quiet --impure --option services.postgres.enable:bool true
use devenv
